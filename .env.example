# Network Configuration
# For local development with Hardhat, defaults are pre-configured:
# RPC URL: http://127.0.0.1:8545
# Chain ID: 31337

# Deployed Contract Address (populated automatically by scripts/deploy.js into frontend/src/contracts/DVote.json)
# VITE_DVOTE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

